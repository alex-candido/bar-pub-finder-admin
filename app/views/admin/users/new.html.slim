= render "breadcrumb"

#users.section
  .flex.flex-col
      .p-1.5.min-w-full.inline-block.align-middle
        = simple_form_for([:admin, @user], html: { class: "form" }) do |f|
          .card
            .card-header
              .header-title
                h2.leading New User
                p.support-text New and more.

            .card-content
              .inline-block.min-w-full.align-middle.py-5.px-6
                == render "form", f: f

            .card-footer
              .footer-content
                .footer-left
                .footer-right
                    .action-buttons.inline-flex.gap-x-2
                      =< link_to admin_users_path, class: "btn-base" do
                          = inline_svg_tag "chevron-left.svg"
                          | Back to users
                      = f.submit "Create User", class: "btn-primary"


