{
  "name": "app",
  "private": "true",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.12",
    "@preline/select": "^2.5.2",
    "@preline/theme-switch": "^2.5.2",
    "@types/leaflet": "^1.9.16",
    "@types/leaflet-providers": "^1.2.4",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "leaflet": "^1.9.4",
    "leaflet-providers": "^2.0.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-static": "^0.473.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^13.0.1",
    "postcss-preset-env": "^10.1.3",
    "preline": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "watch:css:app:compile": "tailwindcss --postcss -c ./config/tailwind.config.js -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --watch",
    "watch:css:admin:compile": "tailwindcss --postcss -c ./config/tailwind.config.js -i ./app/assets/stylesheets/admin.css -o ./app/assets/builds/admin.css --watch",
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:watch": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets --watch"
  }
}
